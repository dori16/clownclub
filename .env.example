# Local development: copy to .env and replace the placeholders.
# Production (Vercel): set the same names in Project → Settings → Environment Variables.
# Never put real credentials in this example or commit .env.

# Password del circo: apre il sito e l'archivio cifrato. Tutti gli amici usano questa.
CLUB_PASSWORD=replace-with-the-circus-password
# Password dell'area Doriano (Google Sheets e notifiche). Solo per te.
ADMIN_PASSWORD=replace-with-your-admin-password
# Firma dei cookie di accesso. Generala con: npm run secret:generate
SESSION_SECRET=replace-with-generated-secret

# Generate a new pair with: npm run vapid:generate
# Keep VAPID_PRIVATE_JWK secret. Keep the key pair stable after subscriptions exist.
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_JWK='{"kty":"EC","crv":"P-256","x":"replace-me","y":"replace-me","d":"replace-me"}'
VAPID_SUBJECT=mailto:you@example.com

# Optional: Google Sheet fixed here instead of the admin panel.
# SHEETS_URL=https://script.google.com/macros/s/.../exec
# SHEETS_TOKEN=at-least-24-random-characters

# Redis (Upstash). On Vercel these are added automatically by the Upstash integration.
# Locally they are optional: without them the dev server uses memory.
# KV_REST_API_URL=https://...upstash.io
# KV_REST_API_TOKEN=...

# Optional, only for npm run vault:init (creates public/seed.clown).
# INITIAL_VAULT_PASSWORD=same-as-CLUB_PASSWORD

# Local server only; the development server binds to 127.0.0.1.
PORT=4173
