# Local development: copy to .env and replace the placeholders.
# Production: configure these names as server-side environment variables.
# Never put real credentials in this example or commit .env.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-your-admin-password

# Local archive initialization only; never sent to the server.
INITIAL_VAULT_PASSWORD=replace-with-a-long-unique-password

# Generate a new pair with: npm run vapid:generate
# Keep VAPID_PRIVATE_JWK secret. Keep the key pair stable after subscriptions exist.
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_JWK='{"kty":"EC","crv":"P-256","x":"replace-me","y":"replace-me","d":"replace-me"}'
VAPID_SUBJECT=https://your-app.example.com

# Local server only; the development server binds to 127.0.0.1.
PORT=4173
